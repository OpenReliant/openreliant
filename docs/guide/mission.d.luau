-- The records a mission declares, and the other types its words take and give.

--- A ship, a capital ship, a station or a marker, such as a nav point.
declare extern type Ship with end
--- A flight group.
declare extern type FlightGroup with end
--- A squad.
declare extern type Squad with end
--- A camera or flight curve.
declare extern type Curve with end
--- A point of a formation.
declare extern type FormationPoint with end
--- A formation, whose points a ship names as `sabres[1]` for the first.
declare extern type Formation with
    [number]: FormationPoint
end
--- A ship, a flight group or a squad: what a trigger watches, and what most commands act on.
export type Entity = Ship | FlightGroup | Squad
--- A place or a direction: `{ x, y, z }`.
export type Vector = { number }
--- The code a trigger runs: a function whose parameters are the values its condition's events carry.
export type Code = (...any) -> number
--- A part, which runs as `go_home()`, and which commands such as `CreateTimer` take.
export type Part = (...any) -> number
--- How a trigger repeats.
export type Repeats = "once" | "always" | Counted | number
--- The game's variables, which `game` holds.
export type GameVariables = {
    jump_ready: number,
    warp_ready: number,
    backup_available: number,
    player_missiles_left: number,
    mcgann_alive: number,
    nicolai_petrov_alive: number,
    ivan_petrov_alive: number,
    kulov_alive: number,
    mission_over: number,
    landing_cleared: number,
    al_rahan_alive: number,
    sharif_alive: number,
    steiner_alive: number,
    mission_success: number,
    players: number,
    krasnaya_alive: number,
    rameses_alive: number,
    kozah_alive: number,
    fixed_gate_alive: number,
    warp_gate_alive: number,
    last_success: number,
    objectives_met: number,
    czar_alive: number,
    ghost_alive: number,
    reliant_alive: number,
    countdown: number,
    chapter2_thread3_shown: number,
    red_dragon_alive: number,
    yamato_alive: number,
    ion_cannons_hold_lock: number,
    [number]: number,
}

-- The tables of fields the declarations take.

export type MissionFields = {
    --- OpenReliant's name for the mission, which the game doesn't read.
    name: string?,
}
export type FlightGroupFields = {
    --- The wing the group's ships are listed in: "player", "second", "third" or "none", the default.
    wing: Wing?,
    --- The formation the group flies in.
    formation: Formation?,
}
export type ShipFields = {
    --- The ship's type.
    type: ShipType,
    --- Its flight group.
    group: FlightGroup?,
    --- Its pilot, by its record of pilotstats.bin.
    pilot: Pilot?,
    --- Where it is, `{ x, y, z }`, in the game's coordinates, Y down; `{ 0, 0, 0 }` by default.
    position: Vector?,
    --- Its yaw, in whole degrees; -1 where the mission leaves the angle unset. 0 by default.
    yaw: number?,
    --- Its pitch, in whole degrees; -1 where the mission leaves the angle unset. 0 by default.
    pitch: number?,
    --- Its roll, in whole degrees; -1 where the mission leaves the angle unset. 0 by default.
    roll: number?,
    --- Where it launches from: `{ from = "reliant", gate = 2 }`. By default it doesn't launch.
    launch: Launch?,
    --- Its place in a formation: `sabres[2]` is the second point of the formation `sabres`.
    formation_point: FormationPoint?,
    --- The loadout tier its missile racks are fitted by; 255, the default, asks for the campaign's.
    tier: number?,
}
export type MarkerFields = {
    --- Its flight group.
    group: FlightGroup?,
    --- Its pilot, by its record of pilotstats.bin.
    pilot: Pilot?,
    --- Where it is, `{ x, y, z }`, in the game's coordinates, Y down; `{ 0, 0, 0 }` by default.
    position: Vector?,
    --- Its yaw, in whole degrees; -1 where the mission leaves the angle unset. 0 by default.
    yaw: number?,
    --- Its pitch, in whole degrees; -1 where the mission leaves the angle unset. 0 by default.
    pitch: number?,
    --- Its roll, in whole degrees; -1 where the mission leaves the angle unset. 0 by default.
    roll: number?,
    --- Where it launches from: `{ from = "reliant", gate = 2 }`. By default it doesn't launch.
    launch: Launch?,
    --- Its place in a formation: `sabres[2]` is the second point of the formation `sabres`.
    formation_point: FormationPoint?,
    --- The loadout tier its missile racks are fitted by; 255, the default, asks for the campaign's.
    tier: number?,
}
export type PointFields = {
    --- Its flight group.
    group: FlightGroup?,
    --- Its pilot, by its record of pilotstats.bin.
    pilot: Pilot?,
    --- Where it is, `{ x, y, z }`, in the game's coordinates, Y down; `{ 0, 0, 0 }` by default.
    position: Vector?,
    --- Its yaw, in whole degrees; -1 where the mission leaves the angle unset. 0 by default.
    yaw: number?,
    --- Its pitch, in whole degrees; -1 where the mission leaves the angle unset. 0 by default.
    pitch: number?,
    --- Its roll, in whole degrees; -1 where the mission leaves the angle unset. 0 by default.
    roll: number?,
    --- Where it launches from: `{ from = "reliant", gate = 2 }`. By default it doesn't launch.
    launch: Launch?,
    --- Its place in a formation: `sabres[2]` is the second point of the formation `sabres`.
    formation_point: FormationPoint?,
    --- The loadout tier its missile racks are fitted by; 255, the default, asks for the campaign's.
    tier: number?,
    --- For a point that marks a place on a curve: `{ curve = camera_curve, at = 0.5 }`.
    marker: Marker?,
}
export type Launch = {
    --- The type of ship it launches from, the first of that type in the mission.
    from: ShipType,
    --- The gate it launches through.
    gate: number,
}
export type Marker = {
    --- The curve it marks a place on.
    curve: Curve,
    --- The share of the way along the curve.
    at: number?,
}
export type CurveFields = {
    --- The ship the curve starts at; none by default.
    start: Ship?,
    --- The ship the curve ends at; none by default.
    finish: Ship?,
    --- Where the curve starts.
    from: Vector?,
    --- Where the curve ends.
    to: Vector?,
    --- The ship the curve's leaving tangent is drawn to.
    leaving_handle: Ship?,
    --- The ship the curve's arriving tangent is drawn to.
    arriving_handle: Ship?,
    --- The curve's leaving tangent.
    leaving: Vector?,
    --- The curve's arriving tangent.
    arriving: Vector?,
}
export type PartFields = {
    --- `true` runs the part as the mission starts, before any trigger is armed.
    start: boolean?,
}
export type TriggerFields = {
    --- "once", the default, which disarms the trigger as it fires; "always"; or `{ counted = 3 }`, which fires that many times each time the script arms it.
    repeats: Repeats?,
    --- The subject's component it watches, by its index; by default the subject itself.
    component: number?,
    --- `true` leaves the trigger's thread to the scheduler rather than running it inside the event.
    deferred: boolean?,
    --- What the event's "Attacker" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `shot_at`.
    attacker: (Entity | number)?,
    --- What the event's "Victim" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `shot_at` and `destroyed`.
    victim: (Entity | number)?,
    --- What the event's "Weapon Fired" must be for the trigger to fire: a number. In triggers of `shot_at`.
    weapon_fired: number?,
    --- What the event's "Killer" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `destroyed`.
    killer: (Entity | number)?,
    --- What the event's "LaunchedShip" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `launched`.
    launched_ship: (Entity | number)?,
    --- What the event's "ReachedShip" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `ship_reached`.
    reached_ship: (Entity | number)?,
    --- What the event's "ApproachingShip" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `proximity_close` and `proximity_general`.
    approaching_ship: (Entity | number)?,
    --- What the event's "ObjectScooped" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `object_scooped`.
    object_scooped: (Entity | number)?,
    --- What the event's "JumpedInShip" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `jumped_in`.
    jumped_in_ship: (Entity | number)?,
    --- What the event's "ShipJumpedIn" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `fixed_gate_jumped_in`.
    ship_jumped_in: (Entity | number)?,
    --- What the event's "ObjectGrabbed" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `ripper_grabbed_object`.
    object_grabbed: (Entity | number)?,
    --- What the event's "ObjectDropped" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `ripper_dropped_object`.
    object_dropped: (Entity | number)?,
    --- What the event's "CloakingShip" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `cloaked` and `decloaked`.
    cloaking_ship: (Entity | number)?,
    --- What the event's "Aggressor" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `targetted`.
    aggressor: (Entity | number)?,
    --- What the event's "TractoredShip" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `tractor_beam_locked` and `tractor_beam_broken`.
    tractored_ship: (Entity | number)?,
    --- What the event's "TractoringShip" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `tractor_beam_locked` and `tractor_beam_broken`.
    tractoring_ship: (Entity | number)?,
    --- What the event's "ChasedShip" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `being_chased`.
    chased_ship: (Entity | number)?,
    --- What the event's "Chaser" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `being_chased`.
    chaser: (Entity | number)?,
    --- What the event's "PlayerTargetted" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `call_reinforcements`.
    player_targetted: (Entity | number)?,
    --- What the event's "ExplosionShip" must be for the trigger to fire: a ship, a flight group, a squad or `any_ship`. In triggers of `explosion_ship`.
    explosion_ship: (Entity | number)?,
}
export type Counted = {
    --- How many times the trigger fires each time the script arms it.
    counted: number,
    --- How many firings are left as the mission starts; by default as many as it counts.
    left: number?,
}

-- The source's own words: its declarations, and the functions and values of its script.

--- Gives the mission's own details.
declare function mission(fields: MissionFields): ()
--- Declares a global: its display name and the value it starts with.
declare function global(name: string, value: number): number
--- Declares a flight group, by its display name.
declare function flight_group(name: string, fields: FlightGroupFields?): FlightGroup
--- Places a ship, a capital ship or a station, by its display name.
declare function ship(name: string, fields: ShipFields): Ship
--- Places a nav point, by its display name.
declare function nav_point(name: string, fields: MarkerFields?): Ship
--- Places a waypoint, by its display name.
declare function waypoint(name: string, fields: MarkerFields?): Ship
--- Places a point, by its display name, such as one a camera curve runs to.
declare function point(name: string, fields: PointFields?): Ship
--- Places a curve point, by its display name.
declare function curve_point(name: string, fields: MarkerFields?): Ship
--- Declares a squad: its display name and its members in their order, ships, ships' components, flight groups and other squads.
declare function squad(name: string, members: { Entity }): Squad
--- Declares a formation: its display name and its points, each where it stands from the formation's origin. A ship names a point as `sabres[1]` for the first.
declare function formation(name: string, points: { Vector }): Formation
--- Declares a curve, which has no display name.
declare function curve(fields: CurveFields): Curve
--- Declares a part: its display name and its code, a function whose parameters are the part's arguments. A part without a function has no block.
declare function part<A...>(name: string, code: ((A...) -> number)?, fields: PartFields?): (A...) -> number
--- Declares code that more than one trigger runs.
declare function handler<A...>(code: (A...) -> number): (A...) -> number
--- Declares a trigger: its subject, the ship, flight group or squad whose events it watches, or nil for none; its condition; its fields, which can be left out; and the code its events run, whose parameters are the values the condition's events carry.
declare function on(subject: Entity?, condition: Condition, fields: (TriggerFields | Code)?, code: Code?): ()
--- A ship's component, by its index.
declare function component<T>(object: T, index: number): T
--- Any of the players' ships, as a value a trigger checks.
declare any_ship: Ship
--- Runs a command the catalogue doesn't have, by its number.
declare function command(number: number, ...: any): ()
--- Starts a part on a thread of its own, with its arguments after the part.
declare function spawn<A...>(part: (A...) -> number, ...: A...): ()
--- Rolls a random choice: `local roll = random()`, then an `if` over the arms' thresholds, `if roll < 50 then`, with the default as `else`.
declare function random(): number
--- The result of the last command.
declare function result(): number
--- The game's variables, by their names, or by their numbers, as in `game[37]`, for those without.
declare game: GameVariables
--- A value of the event that started the thread, by its place, in a part.
declare function thread_value(place: number): any
--- A value an object keeps of its last event of a condition, by its label in the condition catalogue: `last_event(ship, "shot_at", "Hull Damage")`.
declare function last_event(object: Entity, condition: Condition, value: EventValue): any
--- A ship past the mission's records, by its index.
declare function ship_index(index: number): Ship
--- A flight group past the mission's records, by its index.
declare function flight_group_index(index: number): FlightGroup
--- A squad past the mission's records, by its index.
declare function squad_index(index: number): Squad
--- A curve past the mission's records, by its index.
declare function curve_index(index: number): Curve
--- A global past the mission's records, by its index.
declare function global_index(index: number): number
--- A part past the mission's records, by its index.
declare function part_index(index: number): Part
--- An object by its number in the built mission. A number past its records gets an entry of no record in the object table.
declare function object_index(id: number): Entity
--- A formation past the mission's records, by its index.
declare function formation_index(index: number): Formation
--- A formation point by its index among all the mission's points.
declare function formation_point_index(index: number): FormationPoint
--- Whether a ship is in a flight group.
declare function in_flight_group(object: Entity, group: FlightGroup): boolean
--- Whether a ship isn't in a flight group.
declare function not_in_flight_group(object: Entity, group: FlightGroup): boolean
--- Whether an object is in a squad.
declare function in_squad(object: Entity, squad: Squad): boolean
--- Whether an object isn't in a squad.
declare function not_in_squad(object: Entity, squad: Squad): boolean
--- `a > b`, comparing floating-point numbers.
declare function greater_f(a: number, b: number): boolean
--- `a >= b`, comparing floating-point numbers.
declare function greater_equal_f(a: number, b: number): boolean
--- `a < b`, comparing floating-point numbers.
declare function less_f(a: number, b: number): boolean
--- `a <= b`, comparing floating-point numbers.
declare function less_equal_f(a: number, b: number): boolean
--- `a + b`, in floating point.
declare function add_f(a: number, b: number): number
--- `a - b`, in floating point.
declare function sub_f(a: number, b: number): number
--- `a * b`, in floating point.
declare function mul_f(a: number, b: number): number
--- `a / b`, in floating point.
declare function div_f(a: number, b: number): number
--- `target += value`, in floating point.
declare function add_assign_f(target: number, value: number): ()
--- `target -= value`, in floating point.
declare function sub_assign_f(target: number, value: number): ()
--- `target *= value`, in floating point.
declare function mul_assign_f(target: number, value: number): ()
--- `target /= value`, in floating point.
declare function div_assign_f(target: number, value: number): ()

