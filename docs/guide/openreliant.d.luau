type Hooks = {
    -- Adds a handler that runs before the hook's function, or when its event happens.
    add: HooksAdd,
    -- Adds a handler that runs after the hook's function, which sees its result in e.result.
    after: HooksAfter,
}

-- What the engine tells the scripts.

type Mission = {
    number: number,
    file: string,
}
type Outcome = {
    ending: Ending,
    rating: Rating,
}

-- What scripts return.

type LoadScript = {
    engine_handlers: {
        on_records_loaded: (() -> ())?,
    }?,
}
type GlobalScript = {
    engine_handlers: {
        on_init: (() -> ())?,
        on_update: ((seconds: number) -> ())?,
        on_step: (() -> ())?,
        on_mission_start: ((mission: Mission) -> ())?,
        on_mission_end: ((outcome: Outcome) -> ())?,
        on_object_added: ((object: Object) -> ())?,
        on_object_removed: ((object: Object) -> ())?,
    }?,
}
