-- Tables of values, which scripts can only read.

type Orientation = {
    right: vector,
    down: vector,
    forward: vector,
}
type Quadrants = {
    left: number,
    right: number,
    fore: number,
    aft: number,
}
type Mission = {
    number: number,
    file: string,
}
type OrderInfo = {
    name: string,
    priority: number,
    flags: OrderFlags,
}
type OrderFlags = {
    players: boolean,
    one_shot: boolean,
    retaliate: boolean,
    avoidance: boolean,
    send_flight: boolean,
}
type OrderEntry = {
    order: string | number,
    target: Object?,
    component: number?,
}
type FillStyle = {
    colour: vector?,
    alpha: number?,
}
type ShapeStyle = {
    colour: vector?,
    alpha: number?,
    scale: number?,
}
type TextStyle = {
    font: string?,
    base_font: Font?,
    colour: vector?,
    alpha: number?,
    scale: number?,
    align: Align?,
}
type LineStyle = {
    colour: vector?,
    alpha: number?,
    width: number?,
}
type Size = {
    width: number,
    height: number,
}
type Definition = {
    label: string,
    key: Key?,
    modifier: Modifier?,
    button: number?,
    gamepad_button: GamepadButton?,
}
type Effect = {
    name: string,
    shader: string,
    stage: EffectStage?,
    order: number?,
    parameters: { number }?,
    enabled: boolean?,
}
type SurfaceFunction = {
    name: string,
    shader: string,
    textures: { string }?,
    everywhere: boolean?,
    parameters: { number }?,
    enabled: boolean?,
}
type LightingFunction = {
    name: string,
    shader: string,
    parameters: { number }?,
    enabled: boolean?,
}
type Page = {
    title: string,
    options: { Option },
}
type Option = {
    key: string,
    label: string,
    kind: OptionKind,
    default: boolean | number | string,
    description: string?,
    choices: { Choice }?,
    min: number?,
    max: number?,
    step: number?,
}
type Choice = {
    value: boolean | number | string,
    label: string,
}
type Outcome = {
    ending: Ending,
    rating: Rating,
}

-- Objects, which scripts hold by handles.

declare class Object
    -- The slot it fills in the mission, from 0.
    slot: number
    -- Its type, such as `predator`.
    type: ShipType
    -- Its class, such as `fighter`; nil for an object without stats, such as a nav point.
    class: ShipClass?
    -- The side it's on.
    side: Side
    -- Where it is.
    position: vector
    -- Where its axes point: to its right, down and forward, out of its nose (`openreliant.util`).
    orientation: Orientation
    -- How far it moves in a simulation step, of which there are 25 a second.
    velocity: vector
    -- How fast it moves: the length of its velocity.
    speed: number
    -- Whether it's the player's ship.
    is_player: boolean
    -- The order it's following: an original name or a mod-qualified custom name; nil for none.
    order: (string | number)?
    -- The object that last hit it; nil for none, or once that one has left the mission.
    last_attacker: Object?
    -- Its throttle: 1 is full, 2 the afterburner's and -1 reverse thrust's. Its order or its pilot usually sets it each frame.
    throttle: number
    -- How hard it rolls, from -1 to 1. Its order or its pilot usually sets it each frame.
    roll_input: number
    -- How hard it pitches, from -1 to 1. Its order or its pilot usually sets it each frame.
    pitch_input: number
    -- How hard it yaws, from -1 to 1. Its order or its pilot usually sets it each frame.
    yaw_input: number
    -- Its shields in each quadrant.
    shields: Quadrants
    -- Its armour in each quadrant.
    armor: Quadrants
    -- The share of its armour it has left, from about 1 as it's made down to 0: its weakest quadrant against a quadrant's full armour. Nil for an object without stats.
    hull: number?
    -- Whether the object is still in the mission. A handle stops being valid once its object is removed or its mission ends.
    function is_valid(self): boolean
    -- Gives it `order`, aimed at `target` or at nothing, as a mission's SetAI does: the order goes on top of its orders if the one it follows gives way. Returns whether it took. Global scripts can give any object orders, and an object's scripts their own object.
    function give_order(self, order: string | number, target: Object?): boolean
    -- Sends the event `name` to the object's scripts, with `data`, which must be plain data. It arrives at the next update.
    function send_event(self, name: string, data: any): ()
    -- Starts the script `name` of the calling mod on the object, as an object script, and passes `data` to its `on_init`. Returns whether it started. Only global scripts can add scripts.
    function add_script(self, name: string, data: any?): boolean
    -- `hooks.add`, for the calls that concern this object only: a handler for the hook `name`, with an optional `filter`. Returns the handler's handle. Global scripts can hook any object, and an object's scripts their own.
    function hook(self, name: string, handler: (e: any) -> boolean?, filter: (Filter | (e: any) -> boolean)?): HookHandle
    -- Draws the object with the surface function `name`, the calling mod's by its own name or any mod's by the qualified one, reading `parameters`; nil draws it with its textures' functions again. Returns false if no function of that name is registered. Only player scripts can set it.
    function set_surface(self, name: string?, parameters: { number }?): boolean
    -- Stops the script `name` of the calling mod on the object. Returns whether it ran there. Only global scripts can remove scripts.
    function remove_script(self, name: string): boolean
end

-- The records (`openreliant.records`).

declare class Ship
    name: string
    max_speed: number
    inertia: number
    yaw_rate: number
    yaw_inertia: number
    pitch_rate: number
    pitch_inertia: number
    roll_rate: number
    roll_inertia: number
    shield_power: number
    armor_class: number
    afterburner_fuel: number
    shield_recharge: number
    gun_energy: number
    gun_recharge: number
    rounds: number
end
declare class Gun
    name: string
    range: number
    speed: number
    damage: Damage
    fire_rate: number
    shot_energy: number
end
declare class Damage
    shield: number
    hull: number
end
declare class Missile
    name: string
    speed: number
    turn_rate: number
    flight_time: number
    damage: Damage
    lock_time: number
    decoy_chance: number
    lock_range: number
    component_damage: number
end
declare class Pilot
    name: string
    tier_a: PilotTier
    tier_b: PilotTier
    tier_c: PilotTier
    skill: PilotSkill
end
type Records = {
    ships: { [number | string]: Ship },
    guns: { [number | string]: Gun },
    missiles: { [number | string]: Missile },
    pilots: { [number | string]: Pilot },
    text: { [number | string]: string },
    itac_text: { [number | string]: string },
}

-- The packages made from declarations. `openreliant.self` is the script's own Object.

-- OpenReliant's version, and events for the global scripts.
type Core = {
    -- The version of OpenReliant, such as `0.7.0`.
    version: string,
    -- Sends the event `name` to the global and mission scripts, with `data`, which must be plain data. It arrives at the next update.
    send_global_event: (name: string, data: any) -> (),
}

-- The mission's objects, the player's ship and the mission itself.
type World = {
    -- The player's ship, while a mission runs; nil between missions.
    player: Object?,
    -- The mission that runs, with its `number` and its `file`'s name; nil between missions.
    mission: Mission?,
    -- Every object in the mission, in the order of their slots.
    objects: () -> { Object },
}

-- The objects around the script's own.
type Nearby = {
    -- The objects within `radius` of the script's object, or of the player's ship for a player script, nearest first, without it.
    objects: (radius: number) -> { Object },
}

-- What the order table says of each order, the orders each object has, and ending them. An object's give_order gives orders.
type Orders = {
    -- Registers a custom order for this global script's mod. Returns its qualified name, which give_order and orders.info accept. The update callback returns false to finish; callbacks cannot change order stacks. Registrations stop with their script context.
    register: (name: string, definition: {priority: number?, flags: OrderFlags?, init: ((ship: Object, target: Object?, seconds: number) -> ())?, update: (ship: Object, target: Object?, seconds: number) -> boolean?, exit: ((ship: Object, target: Object?, seconds: number) -> ())?}) -> string,
    -- The metadata of an original order or mod-qualified custom order: name, priority and flags. Nil for an unknown or disabled registration.
    info: (order: string | number) -> OrderInfo?,
    -- The orders `object` has, the one it follows first, each with what it's aimed at. The ones below carry on as each ends.
    stack: (object: Object) -> { OrderEntry },
    -- Ends the order `object` follows, as an order ends itself: its exit runs, and the order below it carries on. Returns whether it had one. Global scripts can end any object's orders, and an object's scripts their own object's.
    cancel: (object: Object) -> boolean,
    -- Drops all of `object`'s orders, as a mission's ClearAI does, where the one it follows gives way. Returns whether they were dropped. Global scripts can drop any object's orders, and an object's scripts their own object's.
    clear: (object: Object) -> boolean,
}

-- Drawing over the flight display, while it's shown: text, lines and rectangles, in the window's pixels.
type Hud = {
    -- Whether it's shown this frame, which is when what's drawn on it shows, and its other fields can be read.
    shown: boolean,
    -- The window's width, in pixels.
    width: number,
    -- The window's height, in pixels.
    height: number,
    -- Registers an enabled mod-qualified HUD display for this player context. Its frame callback draws through the HUD package while shown; failure disables only that display.
    register_display: (name: string, definition: {frame: (seconds: number) -> ()}) -> string,
    -- Enables or disables a registered HUD display by qualified name. Returns whether it exists.
    set_display_enabled: (name: string, enabled: boolean) -> boolean,
    -- Draws a PNG from the calling mod at `at`, with `size` in window pixels (nil uses its native size), tinted by `style`. Files are cached for the script context.
    picture: (at: vector, file: string, size: vector?, style: FillStyle?) -> (),
    -- Draws an existing shape from this layer's game sprite set at its anchor in window pixels. style.scale multiplies the game's scale; shape IDs are the existing set indices.
    shape: (at: vector, index: number, style: ShapeStyle?) -> (),
    -- Draws `text` at `at`, in pixels from the window's top left corner, in the game's font, as `style` says.
    text: (at: vector, text: string, style: TextStyle?) -> (),
    -- Draws a line from `from` to `to`, in pixels, as `style` says.
    line: (from: vector, to: vector, style: LineStyle?) -> (),
    -- Fills the rectangle between the corners `from` and `to`, in pixels, as `style` says.
    rectangle: (from: vector, to: vector, style: FillStyle?) -> (),
    -- Measures text in window pixels. style may be a numeric scale (existing API) or a TextStyle selecting the same font and scale as drawing.
    measure: (text: string, style: (number | TextStyle)?) -> Size,
}

-- Drawing over the menus, the front end's screens and the pause menu, while they're shown: text, lines and rectangles, in the window's pixels.
type Ui = {
    -- Whether it's shown this frame, which is when what's drawn on it shows, and its other fields can be read.
    shown: boolean,
    -- The window's width, in pixels.
    width: number,
    -- The window's height, in pixels.
    height: number,
    -- Registers a mod-qualified scripted screen. frame draws through ui, and optional key receives key presses/releases while selected. Show it with show_screen; closing its context closes the screen.
    register_screen: (name: string, definition: {frame: (seconds: number) -> (), key: ((key: Key, down: boolean) -> ())?}) -> string,
    -- Selects a registered screen by qualified name; nil closes the selected screen. Returns whether it exists.
    show_screen: (name: string?) -> boolean,
    -- Draws a PNG from the calling mod at `at`, with `size` in window pixels (nil uses its native size), tinted by `style`. Files are cached for the script context.
    picture: (at: vector, file: string, size: vector?, style: FillStyle?) -> (),
    -- Draws an existing shape from this layer's game sprite set at its anchor in window pixels. style.scale multiplies the game's scale; shape IDs are the existing set indices.
    shape: (at: vector, index: number, style: ShapeStyle?) -> (),
    -- Draws `text` at `at`, in pixels from the window's top left corner, in the game's font, as `style` says.
    text: (at: vector, text: string, style: TextStyle?) -> (),
    -- Draws a line from `from` to `to`, in pixels, as `style` says.
    line: (from: vector, to: vector, style: LineStyle?) -> (),
    -- Fills the rectangle between the corners `from` and `to`, in pixels, as `style` says.
    rectangle: (from: vector, to: vector, style: FillStyle?) -> (),
    -- Measures text in window pixels. style may be a numeric scale (existing API) or a TextStyle selecting the same font and scale as drawing.
    measure: (text: string, style: (number | TextStyle)?) -> Size,
}

-- Whether keys are held, and the controls bound to actions.
type Input = {
    -- Registers a mod-qualified action from a menu script. Its label appears in controls; conflicting defaults stay unassigned. Returns its name for action_down and on_action. Bindings are saved by name.
    register_action: (name: string, definition: Definition) -> string,
    -- Whether `key` is held down.
    key_down: (key: Key) -> boolean,
    -- Whether the controls bound to `action` are held: its key, or its joystick button.
    action_down: (action: string | number) -> boolean,
}

-- Original and mod-qualified camera views, switching views and registering player-script views.
type Camera = {
    -- The original or mod-qualified view the camera shows; nil while no mission is shown.
    view: (string | number)?,
    -- Registers a mod-qualified camera view for this player context. frame returns position and orthonormal orientation; a failed callback returns to cockpit. Mission camera locks take precedence.
    register_view: (name: string, definition: {frame: (object: Object, seconds: number) -> {position: vector, orientation: Orientation}, letterbox: boolean?}) -> string,
    -- Switches to an original or mod-qualified view of object, or the player's ship where nil. Returns whether it switched; mission locks and cutaways take precedence.
    set_view: (view: string | number, object: Object?) -> boolean,
}

-- Interface sounds, music and Betty's lines.
type Audio = {
    -- Plays sound `index` of the game's standard sounds, the menus' and the display's, at `volume` from 0 to 1, or at its loudest where it's nil. Returns whether it played.
    play_sound: (index: number, volume: number?) -> boolean,
    -- Plays the piece `name` from the game's music folder for ever, in place of the music playing.
    play_music: (name: string) -> (),
    -- Betty says `line`. Returns whether she does.
    say: (line: BettyLine) -> boolean,
}

-- Post effects: GLSL fragment shaders from the mod, drawn over the whole frame, before the flight display or after it.
type Postprocessing = {
    -- Registers a post effect: a GLSL fragment shader from the calling mod's file `shader`, drawn over the whole frame. `stage` is `"before_hud"` (the default) or `"after_hud"`, `order` sorts the effects of a stage, lower first, and `parameters` holds up to four numbers its shader reads. Returns the effect's name, qualified with the mod's. A shader that doesn't compile is an error, with its file and line. See the scripting guide for what the shader reads.
    register: (definition: Effect) -> string,
    -- Turns the calling mod's effect `name` on or off, by its own name or the qualified one. Returns whether the mod has it.
    set_enabled: (name: string, enabled: boolean) -> boolean,
    -- Sets the numbers the calling mod's effect `name` reads, up to four; those left out are 0. Returns whether the mod has it.
    set_parameters: (name: string, parameters: { number }) -> boolean,
}

-- Surface and lighting functions: GLSL functions from the mod that change how surfaces are lit.
type Shaders = {
    -- Registers a surface function: a GLSL function `surface` from the calling mod's file `shader`, which changes a pixel before it is lit. It draws on the `textures` it names, on every lit surface without a function of its own where `everywhere` is true, and on the objects given it with `object:set_surface`. `parameters` holds up to four numbers it reads. Returns the function's name, qualified with the mod's. A shader that doesn't compile is an error, with its file and line. See the scripting guide for what the function reads and sets.
    register_surface: (definition: SurfaceFunction) -> string,
    -- Registers a lighting function: a GLSL function `lighting` from the calling mod's file `shader`, which changes how much of each light reaches a pixel. One draws at a time: the enabled one registered last. `parameters` holds up to four numbers it reads. Returns the function's name, qualified with the mod's. A shader that doesn't compile is an error, with its file and line.
    register_lighting: (definition: LightingFunction) -> string,
    -- Turns the calling mod's function `name` on or off, by its own name or the qualified one. Returns whether the mod has it.
    set_enabled: (name: string, enabled: boolean) -> boolean,
    -- Sets the numbers the calling mod's function `name` reads on its textures and everywhere it draws, up to four; those left out are 0. Returns whether the mod has it.
    set_parameters: (name: string, parameters: { number }) -> boolean,
}

-- Sections of plain data for each mod: kept with the saved game, or in the game folder across every game.
type Storage = {
    -- The section `name` of the calling mod's storage that's kept with the saved game, and starts empty with each new game. Global and object scripts change it; other scripts read it.
    game_section: (name: string) -> Section,
    -- The section `name` of the calling mod's storage that's kept in the game folder, across every game. Any script changes it.
    global_section: (name: string) -> Section,
}

-- Timers, kept with the saved game: game time for global and object scripts, real time for player and menu scripts.
type Async = {
    -- Registers `handler` under `name` for the script's mod, for timers to run. Register it as the script runs, so that a timer kept with a saved game finds it again after the game is loaded.
    register_timer: (name: string, handler: (data: any) -> ()) -> (),
    -- Runs the function registered under `name` once `seconds` have passed, with `data`, which must be plain data: seconds of game time for global and object scripts, and of real time for player and menu scripts.
    after: (seconds: number, name: string, data: any?) -> (),
}

-- Orientations, turning points between the world and an object's own frame, and angles. Luau's vector library has the rest of the vector maths.
type Util = {
    -- The point of the world that `point` is in the frame of something at `position` turned as `orientation`: `point`'s x to its right, y down and z forward of it.
    to_world: (position: vector, orientation: Orientation, point: vector) -> vector,
    -- Where the point of the world `point` is in the frame of something at `position` turned as `orientation`: x to its right, y down and z forward of it.
    to_local: (position: vector, orientation: Orientation, point: vector) -> vector,
    -- The angle in radians between the forward axis of something at `position` turned as `orientation` and the direction to `point`: 0 dead ahead, pi straight behind.
    angle_off: (position: vector, orientation: Orientation, point: vector) -> number,
    -- The orientation whose forward axis points along `direction`, turned about its Y axis, then its X axis, with no roll, as the game turns a ship to look at something.
    look_at: (direction: vector) -> Orientation,
    -- `orientation` turned by `angle` radians about its own `axis`: right-handed, so about its Y axis, which points down, a positive angle turns its nose to the right.
    turn: (orientation: Orientation, axis: Axis, angle: number) -> Orientation,
    -- The angles in radians that `orientation` is turned by from looking along the world's Z axis, as the game reads them: x the pitch, y the yaw and z the roll.
    angles: (orientation: Orientation) -> vector,
    -- The orientation turned by `angles` in radians from looking along the world's Z axis, as `angles` gives them: about X, then Y, then Z.
    from_angles: (angles: vector) -> Orientation,
    -- `angle` in radians brought within half a turn either way, from -pi to pi.
    normalize_angle: (angle: number) -> number,
}

-- Reading the game's and the mods' files.
type Vfs = {
    -- Reads the file `name` as a string of its bytes, the way the game does: a mod's copy (the latest mod's first), else the game folder's own file of that name, such as `missions\mission1.dte`, else the member of the game's `resource.hog`. Nil if there is none.
    read: (name: string) -> string?,
    -- Reads the calling mod's own file `name` as a string of its bytes. Nil if the mod doesn't have it.
    read_mod: (name: string) -> string?,
    -- Whether `vfs.read` would find the file `name`.
    exists: (name: string) -> boolean,
}

-- The options a mod offers the player on the mods screen: declaring the page, and reading the values.
type Settings = {
    -- Declares the page of options the mod offers on the mods screen: a title and up to 64 options. Each option has a `key` that scripts read it by, a `label`, a `kind` and a `default`. A `"toggle"` has a boolean default. A `"choice"` has `choices`, each a `value` and a `label`, and a default among their values. A `"number"` has `min`, `max` and `step`, and a default in the range. An option may have a `description`, which the screen writes under the list while the pointer is on it. Only load and menu scripts can use it, as OpenReliant starts, and a mod has one page.
    register_page: (page: Page) -> (),
    -- The value of the option `key` of the calling mod's page: what the player set, or the default. A toggle is a boolean, a number is a number, and a choice is the value of the choice set.
    get: (key: string) -> boolean | number | string,
}

-- Lines and text placed in the world, drawn over the flight display where the camera sees them, for debugging.
type Debug = {
    -- Draws a line between the points `from` and `to` of the world, as `style` says, where the camera sees them.
    line: (from: vector, to: vector, style: LineStyle?) -> (),
    -- Draws `text` at the point `at` of the world, as `style` says, where the camera sees it.
    text: (at: vector, text: string, style: TextStyle?) -> (),
}

-- The interfaces other scripts offer, as `I.<name>`: those of the global scripts to global scripts, those of an object's scripts to the object's other scripts, and those of player and menu scripts to each other. Nil for one nobody offers.
type Interfaces = {
    Flight: {
        to_world: (position: vector, orientation: Orientation, point: vector) -> vector,
        to_local: (position: vector, orientation: Orientation, point: vector) -> vector,
        look_at: (direction: vector) -> Orientation,
        angle_off: (position: vector, orientation: Orientation, point: vector) -> number,
        turn: (orientation: Orientation, axis: Axis, angle: number) -> Orientation,
    },
    AI: {
        register: (name: string, definition: {priority: number?, flags: OrderFlags?, init: ((ship: Object, target: Object?, seconds: number) -> ())?, update: (ship: Object, target: Object?, seconds: number) -> boolean?, exit: ((ship: Object, target: Object?, seconds: number) -> ())?}) -> string,
        info: (order: string | number) -> OrderInfo?,
        stack: (object: Object) -> { OrderEntry },
        cancel: (object: Object) -> boolean,
        clear: (object: Object) -> boolean,
        give_order: (self: Object, order: string | number, target: Object?) -> boolean,
    },
    Combat: {
        add_hook: (name: string, handler: (e: any) -> boolean?, filter: any?) -> HookHandle,
        after_hook: (name: string, handler: (e: any) -> boolean?, filter: any?) -> HookHandle,
    },
    Weapons: {
        add_hook: (name: string, handler: (e: any) -> boolean?, filter: any?) -> HookHandle,
        after_hook: (name: string, handler: (e: any) -> boolean?, filter: any?) -> HookHandle,
    },
    Carriers: {
        give_order: (self: Object, order: string | number, target: Object?) -> boolean,
        add_hook: (name: string, handler: (e: any) -> boolean?, filter: any?) -> HookHandle,
        after_hook: (name: string, handler: (e: any) -> boolean?, filter: any?) -> HookHandle,
    },
    Camera: {
        view: (string | number)?,
        register_view: (name: string, definition: {frame: (object: Object, seconds: number) -> {position: vector, orientation: Orientation}, letterbox: boolean?}) -> string,
        set_view: (view: string | number, object: Object?) -> boolean,
    },
    Controls: {
        register_action: (name: string, definition: Definition) -> string,
        key_down: (key: Key) -> boolean,
        action_down: (action: string | number) -> boolean,
    },
    HUD: {
        shown: boolean,
        width: number,
        height: number,
        register_display: (name: string, definition: {frame: (seconds: number) -> ()}) -> string,
        set_display_enabled: (name: string, enabled: boolean) -> boolean,
        picture: (at: vector, file: string, size: vector?, style: FillStyle?) -> (),
        shape: (at: vector, index: number, style: ShapeStyle?) -> (),
        text: (at: vector, text: string, style: TextStyle?) -> (),
        line: (from: vector, to: vector, style: LineStyle?) -> (),
        rectangle: (from: vector, to: vector, style: FillStyle?) -> (),
        measure: (text: string, style: (number | TextStyle)?) -> Size,
    },
    Audio: {
        play_sound: (index: number, volume: number?) -> boolean,
        play_music: (name: string) -> (),
        say: (line: BettyLine) -> boolean,
    },
    Missions: {
        player: Object?,
        mission: Mission?,
        objects: () -> { Object },
    },
    Campaign: {
        mission: Mission?,
        send_global_event: (name: string, data: any) -> (),
    },
    FrontEnd: {
        shown: boolean,
        width: number,
        height: number,
        register_screen: (name: string, definition: {frame: (seconds: number) -> (), key: ((key: Key, down: boolean) -> ())?}) -> string,
        show_screen: (name: string?) -> boolean,
        picture: (at: vector, file: string, size: vector?, style: FillStyle?) -> (),
        shape: (at: vector, index: number, style: ShapeStyle?) -> (),
        text: (at: vector, text: string, style: TextStyle?) -> (),
        line: (from: vector, to: vector, style: LineStyle?) -> (),
        rectangle: (from: vector, to: vector, style: FillStyle?) -> (),
        measure: (text: string, style: (number | TextStyle)?) -> Size,
    },
    [string]: any,
}

-- A section of a mod's storage: its fields by name, each plain data. Reading one gives a copy.
type Section = { [string]: any }

-- The hooks (`openreliant.hooks`). Each handler gets `e`, whose class is named after the hook.

declare class HookHandle
    -- Removes the handler. Returns whether it was there.
    function remove(self): boolean
end

-- The objects a handler is for: each test that's given must hold.
type Filter = {
    object: Object?,
    type: (ShipType | { ShipType })?,
    class: (ShipClass | { ShipClass })?,
    side: (Side | { Side })?,
}

-- Damage to `object` from `attacker`. Its shield in `quadrant` takes `value` first. What gets through, times `factor`, damages its armour (`object_armor_damage`). `kind` says what dealt the damage.
declare class ObjectDamage
    object: Object
    quadrant: Quadrant
    value: number
    factor: number
    attacker: Object
    kind: DamageKind
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- Damage to the armour of `object` in `quadrant`, once its shield there is down: `value` from `attacker`, of `kind`. Armour below zero destroys the object (`object_destroyed`).
declare class ObjectArmorDamage
    object: Object
    quadrant: Quadrant
    value: number
    attacker: Object
    kind: DamageKind
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- Damage to one of the components of `object`, such as a capital ship's turret or engine: `value` from `attacker`, of `kind`.
declare class ComponentDamage
    object: Object
    value: number
    attacker: Object
    kind: DamageKind
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- How hard damage of `kind` lands on `object` at the game's difficulty: the result is what `value` becomes.
declare class DamageByDifficulty
    object: Object
    kind: DamageKind
    value: number
    result: number
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): number?
end

-- The end of `object`: its pilot ejects, or it explodes. With `may_spin`, it may spin out as it goes; with `no_eject`, the player's pilot doesn't eject.
declare class ObjectDestroyed
    object: Object
    may_spin: boolean
    no_eject: boolean
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- `owner` fires a shot of `gun_type` from one of its guns. `heard` says whether the shot makes a sound.
declare class BulletFire
    owner: Object
    gun_type: GunType
    heard: boolean
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- `launcher` launches a missile from one of its racks.
declare class MissileLaunch
    launcher: Object
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- One of the missile turrets of `object` launches a Screamer.
declare class MissileLaunchTurret
    object: Object
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- `object` runs its current order, as it does each frame. Each order's routines have hooks of their own, such as `order_fight`.
declare class ObjectOrders
    object: Object
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- `object`, a fighter, turns on whoever last hit it, once it has taken enough damage lately and its order allows it.
declare class OrderRetaliate
    object: Object
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- What a hook on one of the order table's routines sees.
declare class OrderRoutine
    object: Object
    -- Runs the rest of the call now: the handlers after this one, then the function.
    function original(self): ()
end

-- `attacker` hits `object`: its component number `component`, or the object as a whole when `component` is nil.
declare class ShotAt
    object: Object
    attacker: Object
    component: number?
end

-- `object` is destroyed, or its component number `component`. `attacker` is what last hit it. Each ship is destroyed once, though its components can be destroyed before it.
declare class Destroyed
    object: Object
    component: number?
    attacker: Object?
end

-- `object` has launched from its carrier.
declare class Launched
    object: Object
end

-- `reached_by` has reached the mission's ship `ship`, a point on a curve it follows or the curve's end.
declare class ShipReached
    ship: number
    reached_by: Object
end

-- The director's camera has reached the mission's ship `ship`, a point on its curve or the curve's end.
declare class CameraReached
    ship: number
end

-- `object` has taken `scooped` aboard with its tractor beam.
declare class ObjectScooped
    object: Object
    scooped: Object
end

-- JUMP DRIVE took the jump the mission had ready for `object`, the player's ship.
declare class PlayerReadyToJump
    object: Object
end

-- `object` has jumped in.
declare class JumpedIn
    object: Object
end

-- `object` has come in through the fixed gate `gate`.
declare class FixedGateJumpedIn
    object: Object
    gate: Object
end

-- JUMP DRIVE took the warp the mission had ready for `object`, the player's ship.
declare class PlayerReadyToWarp
    object: Object
end

-- REQUEST BACKUP brought the mission's backup for `object`, the player's ship.
declare class PlayerWantsBackup
    object: Object
end

-- `object`, a Ripper, has `grabbed` aboard.
declare class RipperGrabbedObject
    object: Object
    grabbed: Object
end

-- `object`, a Ripper, has let go of `dropped`, or fitted it to a ship.
declare class RipperDroppedObject
    object: Object
    dropped: Object
end

-- `object` cloaks.
declare class Cloaked
    object: Object
end

-- `object` uncloaks.
declare class Decloaked
    object: Object
end

-- `object` has retrieved its limpet pod and left the docking port.
declare class Undocked
    object: Object
end

-- `object` has docked.
declare class Docked
    object: Object
end

-- The explosion that `object` set off is over.
declare class ExplosionShip
    object: Object
end

-- A mission has started: number `number`, from the file `file`. Its first ships are there.
declare class MissionStarted
    number: number
    file: string
end

-- The mission ends: `ending` says how it ended for the player, and `rating` how its script rated it.
declare class MissionEnded
    ending: Ending
    rating: Rating
end

-- `object` has been added to the mission.
declare class ObjectAdded
    object: Object
end

-- `object` is leaving the mission: it has blown up, or its slot is being reset. Its handle stops being valid after this.
declare class ObjectRemoved
    object: Object
end

-- `object` has started `order`, which has come to the top of its orders. One-shot orders, which run once and end straight away, don't start.
declare class OrderStarted
    object: Object
    order: Order
end

-- `object` has ended `order`, which it had started, as the order was popped or replaced.
declare class OrderEnded
    object: Object
    order: Order
end

-- The mission's trigger number `trigger` has fired on an event of `condition`. It's one of `object`'s triggers, or a flight group's or a squad's when `object` is nil.
declare class TriggerFired
    trigger: number
    condition: Condition
    object: Object?
end

