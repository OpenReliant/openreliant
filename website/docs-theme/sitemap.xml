{#- The docs' sitemap for search engines: each page's address, and the day git last changed its
    file, where git says (docs_hooks.py). -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for file in pages %}
  {%- if not file.page.is_link and file.page.canonical_url %}
  <url>
    <loc>{{ file.page.canonical_url|e }}</loc>
    {%- if file.page.update_date %}
    <lastmod>{{ file.page.update_date }}</lastmod>
    {%- endif %}
  </url>
  {%- endif %}
{%- endfor %}
</urlset>
