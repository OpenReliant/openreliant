.{
    .name = .openreliant,
    .version = "1.1.0", // x-release-please-version
    .fingerprint = 0x51560fdd72ea15d0,
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        .shader_compiler = .{ .path = "deps/shader-compiler" },
        .texture_compressor = .{ .path = "deps/texture-compressor" },
        .sdl = .{
            .url = "git+https://github.com/castholm/SDL.git?ref=v0.6.1+3.4.20#ce475292f172d506468218f939ef607d9be5e083",
            .hash = "sdl-0.6.1+3.4.20-SDL--rskqQH3W9l4AJX-kdZ93M9XuhsqLrUsd2fnUE_X",
        },
        .libarchive = .{
            .path = "deps/libarchive",
        },
        .openal_soft = .{
            .path = "deps/openal-soft",
        },
        .ffmpeg = .{
            .path = "deps/ffmpeg",
        },
        .freetype = .{
            .path = "deps/freetype",
        },
        .luau = .{
            .path = "deps/luau",
        },
        .zlib = .{ .path = "deps/zlib" },
        .translate_c = .{
            .url = "git+https://codeberg.org/ziglang/translate-c?ref=2.0.2#c11030012dc325d446474d17b78c242fd1d622ec",
            .hash = "translate_c-2.0.2-Q_BUWvBNBwBgPKQJPblip6M7AHNK_IPNPmyv4rSIQMQc",
        },
        .rc = .{
            .url = "git+https://codeberg.org/ziglang/rc?ref=zig-0.17.x#a8a3b3cebbe6e414fa12d6ad028c56a3a349c75e",
            .hash = "rc-0.0.0-rMftL71EAAAxhe4swpM5rrfcmC9k_j7ApwJJPRssBiDL",
        },
    },
    // The package holds what the build needs, so that other projects can use the library: the
    // modules embed the guide's definitions and reference pages, and the scripting module's tests
    // embed the example mods.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "deps",
        "assets",
        "docs/guide",
        "examples/mods",
    },
}
